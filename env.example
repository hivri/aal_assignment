# PostgreSQL connection. Replace the password with your local database password.
DATABASE_URL=postgresql://leadflow_user:YOUR_DATABASE_PASSWORD@localhost:5432/leadflow

# Generate a long, random value for JWT signing. Never reuse this example value.
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Groq AI provider. Keep this key on the backend; never expose it to the browser.
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b

# Seed users (used by: cd backend && python seed.py)
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

SEED_SALES_NAME=Sales Representative
SEED_SALES_EMAIL=sales@example.com
SEED_SALES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

SEED_DELIVERY_NAME=Delivery Member
SEED_DELIVERY_EMAIL=delivery@example.com
SEED_DELIVERY_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
